# GitHub repository containing SKILL.md files.
skills_registry_owner      = "sce81"
skills_registry_repository = "Port-Skills-Registry"
skills_registry_branch     = "main"

# The current registry stores its Markdown skills in this directory.
# Set to "" to discover Markdown files at every depth in the repository.
skills_registry_path = "terraform-skills"

# Default when a source file omits location in its YAML front matter.
default_skill_location = "global"

# Port roles allowed to trigger the sync workflow.
sync_workflow_roles = ["Member"]

# Installed Port GitHub Ocean integration.
github_ocean_installation_id = "github-ocean"

# Do not add Port or GitHub tokens here. Set:
# PORT_CLIENT_ID
# PORT_CLIENT_SECRET
# TF_VAR_skills_registry_token
